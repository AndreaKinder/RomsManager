# === Apple Code Signing (optional — only for macOS distribution with Apple Developer cert) ===
# Leave all vars unset for local dev — the app runs unsigned without issues.
# On macOS Sequoia+, ad-hoc signing + hardened runtime triggers SIGKILL (Code Signature Invalid).
# Only set these when you have a paid Apple Developer Program membership ($99/yr).

# Your Apple ID email
APPLE_ID=your-apple-id@email.com

# App-specific password generated at https://appleid.apple.com
APPLE_NOTARIZATION_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Team ID from https://developer.apple.com/account → Membership
APPLE_TEAM_ID=ABCDE12345

# Certificate identity name — run `security find-identity -v -p codesigning`
APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (ABCDE12345)

# === CI only — not needed locally ===
# Base64-encoded .p12 certificate file:
#   openssl base64 -in certificate.p12 | tr -d '\n' | pbcopy
APPLE_CERTIFICATE_BASE64=

# Password protecting the .p12 certificate
APPLE_CERTIFICATE_PASSWORD=

# Temporary keychain password (any value, used only in CI)
KEYCHAIN_PASSWORD=
